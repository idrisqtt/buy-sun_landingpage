{
  "name": "buysun-server",
  "version": "1.0.0",
  "private": true,
  "description": "BUY SUN backend: leads and anketas from buysun.kz, stored in Postgres and sent to Bitrix24 and email",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.7",
    "zod": "^4.6.7",
    "prisma": "^7.10.1"
  },
  "overrides": {
    "ip-address": "10.7.4"
  }
}
