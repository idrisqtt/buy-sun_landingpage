# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3001
# 127.0.0.1 on a plain server; 0.0.0.0 inside a container
HOST=127.0.0.1

# Postgres connection
DATABASE_URL=postgresql://buysun:buysun@localhost:5433/buysun?schema=public

# Where anketa PDFs and photos are stored (outside the web root)
UPLOAD_DIR=./uploads

# Site address(es) allowed to send forms, comma separated
FRONTEND_URL=https://buysun.kz

# Bitrix24 incoming webhook with the "crm" scope, for example
# https://buysun.bitrix24.kz/rest/1/abcdef123456
# Empty: leads are only stored and emailed.
BITRIX_WEBHOOK_URL=
# Optional: Bitrix24 user id responsible for new leads
BITRIX_ASSIGNED_BY_ID=

# Email copy of every lead. Empty SMTP_HOST: no emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BUY SUN сайт <no-reply@buysun.kz>"
LEADS_EMAIL_TO=

# Delete leads and their files older than this many days. Empty: keep forever.
RETENTION_DAYS=
