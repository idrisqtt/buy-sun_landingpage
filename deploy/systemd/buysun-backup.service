[Unit]
Description=BUY SUN: nightly backup of leads (database and anketa files)
After=postgresql.service

[Service]
Type=oneshot
User=buysun
Group=buysun
EnvironmentFile=/opt/buysun/shared/server.env
Environment=ENV_FILE=/dev/null
ExecStart=/opt/buysun/repo/server/scripts/backup.sh
TimeoutStartSec=1h
